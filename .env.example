SUPERVISOR_PORT=3001
MCP_PORT=3002
POOL_SIZE=2
SANDBOX_IMAGE=everything-sandbox:latest
SANDBOX_TIMEOUT_MS=30000

# Leave empty to deny all tool calls (safe default).
# Set to comma-separated tool names to auto-approve in local dev only.
# Example: AUTO_APPROVE_TOOLS=run_bash,git_op
# NEVER set this in production — use the Phase 4 Approval Gate UI instead.
AUTO_APPROVE_TOOLS=

# Required: bearer token for MCP server authentication.
# Generate with: openssl rand -hex 32
MCP_API_KEY=your-secret-key-here
