# Must match the group that owns /var/run/docker.sock on the host, or the
# supervisor container can't reach Docker. Find it with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

SUPERVISOR_PORT=3001
MCP_PORT=3002
MAX_RUNNING_SANDBOXES=2
SANDBOX_IMAGE=everything-sandbox:latest
SANDBOX_TIMEOUT_MS=30000

# Tool names (comma-separated, real unprefixed names) that skip the approval prompt for connectors YOU configured here.
# Empty = the safe default list (read_log, get_path, search_notes and the browser tools — opening a page is approved per domain, not per tool).
# Connectors added in Settings are never covered by this list. Text-file edits (read_file/edit_file/write_file) need no approval.
# NEVER put run_bash or git_op here in production.
AUTO_APPROVE_TOOLS=

# --- Secrets ---
# Every secret below is REQUIRED and must be generated, not invented:  openssl rand -hex 32
# Services refuse to start with a placeholder, a value shorter than 24 characters or a repetitive one
# (ALLOW_WEAK_SECRETS=true downgrades that to a warning — local development only).

# Bearer token for the sandbox MCP server and for the Playwright MCP server.
MCP_API_KEY=
PLAYWRIGHT_MCP_API_KEY=
# Bearer token for the sandbox-supervisor API (exec / files / volumes of every sandbox). Sent by sandbox-mcp and the web server.
SUPERVISOR_TOKEN=

# Browser agent SSRF guard: private hosts the browser may reach ON PURPOSE (comma-separated,
# default none). Public internet is always allowed; LAN/loopback/link-local/Docker are not.
BROWSER_ALLOW_PRIVATE_HOSTS=

# --- N4: git-proxy (sandbox git <-> github.com) ---
# Shared secret between the orchestrator (web server) and git-proxy: protects /admin/tokens on
# git-proxy and authenticates git-proxy's calls to /internal/* on the orchestrator.
# Generate with: openssl rand -hex 32. Keep /internal/* off the public internet (see deploy/nginx-everythingapp.conf.example).
GIT_PROXY_ADMIN_TOKEN=
# Where git-proxy reaches the orchestrator's /internal/* endpoints (github-token, push-approval, audit).
GIT_PROXY_ORCHESTRATOR_URL=http://everythingapp-web:3000
# Host address the proxy port is published on (set to the sandbox bridge gateway IP so sandboxes can reach it).
GIT_PROXY_BIND=127.0.0.1
# Max wait for a push approval decision before the push is rejected.
PUSH_APPROVAL_TIMEOUT_MS=600000
# Branches whose unverified (possibly forced) updates always need approval, even with pushMode=allow.
GIT_PROXY_PROTECTED_BRANCHES=main,master
GIT_PROXY_DEFAULT_TOKEN_TTL_SECONDS=3600
GIT_PROXY_MAX_TOKEN_TTL_SECONDS=86400
# GitHub PAT: used by github-mcp, and by git-proxy as fallback when the orchestrator has no
# per-project GitHub token.
GITHUB_PAT=

# Browser domain/JS policy (operator layer; per-project policy from the cli can only tighten it).
# Comma-separated globs, e.g. "example.com,*.example.com". Empty allowlist = any public domain.
BROWSER_DOMAIN_ALLOW=
BROWSER_DOMAIN_DENY=
# disabled | review | allowed
BROWSER_JS_POLICY=allowed
# Browser domains are NOT configured here: the chat asks per domain (Allow once / this chat / always).
# BROWSER_DOMAIN_ALLOW above is a hard restriction on top of that, BROWSER_DOMAIN_DENY a hard block.

# --- Web search (web_search tool) ---
# Normally set in Settings → Web. Optional defaults for a fresh install:
# SEARXNG_URL=http://searxng:8080     # a SearXNG with the json format enabled (settings.yml: search.formats: [html, json])
# BRAVE_API_KEY=                      # used when Settings → Web has "Brave" selected and no key saved there
SEARXNG_URL=
BRAVE_API_KEY=

# Push alert when an approval / question / urgent item is waiting. Normally set in Settings → Notifications (stored encrypted);
# this is the fallback for a headless install. ntfy, Discord and Slack addresses work.
NOTIFY_WEBHOOK_URL=

# --- N4: GitHub connection (Settings → GitHub) ---
# GitHub App for "Connect GitHub" via device flow (enable "Device Flow" in the App settings).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# How git inside the sandbox reaches git-proxy, e.g. http://172.30.0.1:8080 (bridge gateway, with GIT_PROXY_BIND set to it).
GIT_PROXY_SANDBOX_URL=

# --- Web UI / orchestrator ---
# Bearer token for server authentication. Generate with: openssl rand -hex 32
SERVER_AUTH_TOKEN=
# Login password for the web UI (session cookie). Defaults to SERVER_AUTH_TOKEN when empty.
SERVER_PASSWORD=
# Time zone for the daily Gazeta digest (IANA name, e.g. Europe/Berlin). UTC when empty.
TZ=
# Encrypts provider API keys at rest (AES-256-GCM). Generate with: openssl rand -hex 32
KEY_VAULT_SECRET=
# Ghost chats may use only these connectors (comma-separated, default sandbox,obsidian; empty = no connector tools).
# GHOST_CONNECTORS=sandbox,obsidian
# Usage, approval-audit and replay rows older than this many months are removed daily; 0 keeps everything. Chats are never deleted.
# RETENTION_MONTHS=12
# Tool output sent back to the model is cut to head+tail at this many characters (default 12000).
TOOL_OUTPUT_MAX_CHARS=
# policy.json: always-allow / always-block command prefixes, known domains, default browser policy.
# Defaults to policy.json next to the database. Edited by hand; applied on the next command.
EVERYTHINGAPP_POLICY_FILE=

