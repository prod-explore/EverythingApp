# Installs the egress guard at boot, after Docker created DOCKER-USER.
#   sudo cp deploy/ea-egress-guard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ea-egress-guard
# Adjust paths/env to your checkout.
[Unit]
Description=EverythingApp egress guard (block private networks from internet-facing containers)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=EGRESS_BRIDGES=br-ea-browser
# Environment=EGRESS_ALLOW=192.168.1.50:11434
ExecStart=/opt/everythingapp/deploy/egress-guard.sh apply
ExecStop=/opt/everythingapp/deploy/egress-guard.sh remove

[Install]
WantedBy=multi-user.target
