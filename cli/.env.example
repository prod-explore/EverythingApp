# Required to save provider API keys from the UI (Settings → Models). Keys are
# stored AES-256-GCM encrypted in the SQLite db; this secret is what unlocks
# them and it lives ONLY here, never in the db. >= 32 chars.
# Generate with: openssl rand -hex 32   — losing/changing it means re-entering keys.
KEY_VAULT_SECRET=

# Optional legacy fallback — used only if no Anthropic key is stored in the vault.
# Gemini and DeepSeek keys are vault-only on purpose (no env var).
# ANTHROPIC_API_KEY=

# Optional — per-model price overrides, USD per million tokens (also how to price
# a model that isn't in the built-in catalog). cacheWrite defaults to `input`,
# cacheRead to input/10.
# MODEL_PRICING_JSON={"deepseek-chat":{"input":0.28,"output":0.42,"cacheRead":0.028}}

# Optional — override the default model.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional — Anthropic's hosted web_search tool. On by default; set to "false" to disable.
# WEB_SEARCH_ENABLED=true

# MCP connectors — entirely config-driven. List the names you want active,
# then set MCP_<NAME>_URL (and _API_KEY if the server needs auth) for each.
MCP_CONNECTORS=sandbox,obsidian,playwright,github

MCP_SANDBOX_URL=http://localhost:3002/mcp/sse
MCP_SANDBOX_API_KEY=

MCP_OBSIDIAN_URL=https://obsidian.futumore.pl/mcp/sse
MCP_OBSIDIAN_API_KEY=

# Phase 4: Playwright browser tool (dual-LLM quarantine)
MCP_PLAYWRIGHT_URL=http://localhost:3003/mcp/sse
MCP_PLAYWRIGHT_API_KEY=

# Phase 4: GitHub connector (official github-mcp-server)
# Uses a Personal Access Token. PAT needs: repo, read:user scopes.
# Never share this with the sandbox — it's only in this env and github-mcp.
# Generate at: https://github.com/settings/tokens
MCP_GITHUB_URL=http://localhost:3004/mcp
MCP_GITHUB_API_KEY=   # same value as GITHUB_PAT below
GITHUB_PAT=

# Phase 4: n8n pipelines (uncomment and fill in after deploying n8n)
# MCP_CONNECTORS=sandbox,obsidian,playwright,github,n8n
# MCP_N8N_URL=http://localhost:5678/mcp/daily-routine   # or the MCP trigger path
# MCP_N8N_API_KEY=

# Optional — override which (real, unprefixed) tool names skip the approval
# prompt. Comma-separated. Defaults to read_log,get_path,search_notes,browse_url.
# Note: browse_url is auto-approved by default since it goes through quarantine.
# AUTO_APPROVE_TOOLS=read_log,get_path,search_notes,browse_url

# --- server.ts only (npm run server) — the MVP web/mobile bridge ---
# Required — shared secret every browser request must send as
# `Authorization: Bearer <token>`. Generate with: openssl rand -hex 32
SERVER_AUTH_TOKEN=

# Optional — HTTP port to listen on.
# PORT=3000

# --- docker-compose only ---
# Docker socket group ID on the host. Find with: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999

# Sandbox pool config (optional — defaults shown)
# POOL_SIZE=2
# SANDBOX_IMAGE=everything-sandbox:latest
# SANDBOX_IDLE_TIMEOUT_MS=1800000   # 30 min
# SANDBOX_WATCHDOG_INTERVAL_MS=120000  # 2 min

# --- Phase 4: Playwright quarantine model ---
# URL of your local OpenAI-compatible API (LM Studio / Ollama running 24/7).
# host.docker.internal resolves to the Docker host from inside containers.
# QUARANTINE_MODEL_URL=http://host.docker.internal:11434/v1
# QUARANTINE_MODEL=llama-3.1-8b-instruct

# Separate API key for the playwright-mcp service
PLAYWRIGHT_MCP_API_KEY=

# --- Phase 4: n8n ---
N8N_USER=admin
N8N_PASSWORD=
# SEPARATE Resend API key for n8n — NOT the same as Skarpa Bytom's key!
# Skarpa's key and n8n's key must be from different Resend accounts/domains.
N8N_RESEND_API_KEY=
# N8N_HOST=localhost
# N8N_WEBHOOK_URL=https://n8n.futumore.pl/
