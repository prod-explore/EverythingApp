# Required to save provider API keys from the UI (Settings → Models). Keys are
# stored AES-256-GCM encrypted in the SQLite db; this secret is what unlocks
# them and it lives ONLY here, never in the db. >= 32 chars.
# Generate with: openssl rand -hex 32   — losing/changing it means re-entering keys.
KEY_VAULT_SECRET=

# Optional legacy fallback — used only if no Anthropic key is stored in the vault.
# Gemini and DeepSeek keys are vault-only on purpose (no env var).
# ANTHROPIC_API_KEY=

# Optional — per-model price overrides, USD per million tokens (also how to price
# a model that isn't in the built-in catalog). cacheWrite defaults to `input`,
# cacheRead to input/10.
# MODEL_PRICING_JSON={"deepseek-chat":{"input":0.28,"output":0.42,"cacheRead":0.028}}

# Optional — override the default model.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional — Anthropic's hosted web_search tool. On by default; set to "false" to disable.
# WEB_SEARCH_ENABLED=true

# MCP connectors — entirely config-driven. List the names you want active,
# then set MCP_<NAME>_URL (and _API_KEY if the server needs auth) for each.
# Adding a new connector (GitHub's official remote MCP server, n8n once it's
# deployed, a calendar MCP, ...) never needs a code change — just add its name
# here and its two env vars below.
MCP_CONNECTORS=sandbox,obsidian

MCP_SANDBOX_URL=http://localhost:3002/mcp/sse
MCP_SANDBOX_API_KEY=

MCP_OBSIDIAN_URL=https://obsidian.futumore.pl/mcp/sse
MCP_OBSIDIAN_API_KEY=

# Example for later — GitHub's official remote MCP server (OAuth or PAT; PAT
# shown here for simplicity). Toolset URLs are documented at
# https://github.com/github/github-mcp-server/blob/main/docs/remote-server.md
# MCP_CONNECTORS=sandbox,obsidian,github
# MCP_GITHUB_URL=https://api.githubcopilot.com/mcp/
# MCP_GITHUB_API_KEY=<personal access token>

# Example for later — once n8n is deployed with an MCP Server Trigger workflow
# MCP_CONNECTORS=sandbox,obsidian,n8n
# MCP_N8N_URL=https://n8n.futumore.pl/mcp/<path>
# MCP_N8N_API_KEY=

# Optional — override which (real, unprefixed) tool names skip the approval
# prompt. Comma-separated. Defaults to read_log,get_path,search_notes.
# AUTO_APPROVE_TOOLS=read_log,get_path,search_notes

# --- server.ts only (npm run server) — the MVP web/mobile bridge, not the CLI ---
# Required — shared secret every browser request must send as
# `Authorization: Bearer <token>`. One user, one token — not the per-account
# auth §11 eventually calls for. Generate with: openssl rand -hex 32
SERVER_AUTH_TOKEN=

# Optional — HTTP port to listen on. Bind to 127.0.0.1 in production and put
# it behind the existing Nginx+Certbot for HTTPS, same pattern as the other
# services on the Pi (see docker-compose.yml).
# PORT=3000
